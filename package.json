  "scripts": {
    "test:a11y": "node tests/a11y.mjs",
    "serve": "node -e \"const{createServer}=require('http'),{readFile}=require('fs');createServer((q,s)=>readFile('.'+(q.url==='/'?'/index.html':q.url.split('?')[0]),(e,d)=>e?s.writeHead(404).end():s.end(d))).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "playwright": "1.63.0"
  }
}
